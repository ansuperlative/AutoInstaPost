    {
      "parameters": {
        "jsCode": "// Flatten all previously used topics into a lowercase array for comparison\nconst topics = items.map(i => (i.json.Topic || '').toString().trim().toLowerCase()).filter(Boolean);\nreturn [{ json: { usedTopics: topics, retryCount: 0 } }];"
      },
      "id": "extract-used-topics",
      "name": "Code - Build Used-Topics List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1120,
        780
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', messages: [ { role: 'system', content: 'You are a creative director for a high-end nature Instagram page. You output ONLY plain text, never markdown, never quotes, never numbering, never explanations.' }, { role: 'user', content: `Generate ONE short, specific nature scene topic (5-8 words), different in location, season, and mood from anything on this list: ${JSON.stringify($json.usedTopics)}. Retry attempt: ${$json.retryCount}. Respond with ONLY the topic text.` } ], temperature: 1.0, max_tokens: 60 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "generate-topic",
      "name": "Groq - Generate Nature Topic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -920,
        780
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '';\nconst topic = raw.replace(/[\\n\\r\"']/g, '').trim();\nconst used = $('Code - Build Used-Topics List').first().json.usedTopics;\nconst retryCount = $('Code - Build Used-Topics List').first().json.retryCount;\nconst isDuplicate = used.includes(topic.toLowerCase());\nreturn [{ json: { topic, isDuplicate, retryCount } }];"
      },
      "id": "parse-check-topic",
      "name": "Code - Parse & Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        780
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "dup-cond",
              "leftValue": "={{ $json.isDuplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "retry-cond",
              "leftValue": "={{ $json.retryCount }}",
              "rightValue": "={{ $('Init Config (env-driven)').first().json.max_topic_retries }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-duplicate-retry",
      "name": "IF Duplicate & Retries Left",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -520,
        780
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json, retryCount: $json.retryCount + 1 } }];"
      },
      "id": "increment-retry",
      "name": "Code - Increment Retry Counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        960
      ]
    },
    {
      "parameters": {
        "jsCode": "// Safety net: after max retries, force uniqueness with a timestamp suffix\nlet topic = $json.topic;\nif ($json.isDuplicate) {\n  topic = `${topic} (${new Date().toISOString().slice(0,10)})`;\n}\nreturn [{ json: { topic } }];"
      },
      "id": "finalize-topic",
      "name": "Code - Finalize Unique Topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        780
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', messages: [ { role: 'system', content: 'You write cinematic AI image-generation prompts for FLUX/Pollinations. You output ONLY the prompt text as comma-separated tags, no preamble, no markdown. HARD LIMIT: your entire output must be under 60 words and under 400 characters. Never repeat a tag or synonym twice.' }, { role: 'user', content: `Write a concise, highly detailed cinematic AI image-generation prompt (STRICTLY under 60 words) for a portfolio-quality nature photograph of: \"${$json.topic}\". Cover, briefly: lighting, composition, atmosphere, camera/lens, color palette. Include the quality tags: ultra detailed, National Geographic quality, 8K, masterpiece — each ONCE only. Output ONLY the prompt text, no repetition.` } ], temperature: 0.7, max_tokens: 110 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "generate-image-prompt",
      "name": "Groq - Generate Image Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -140,
        780
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '';\nlet prompt = raw.trim();\n// Safety net: hard-cap length regardless of what the model returns, so the\n// downstream Pollinations URL can never blow past safe URL-length limits.\nconst MAX_CHARS = 400;\nif (prompt.length > MAX_CHARS) {\n  const cut = prompt.slice(0, MAX_CHARS);\n  const lastComma = cut.lastIndexOf(',');\n  prompt = (lastComma > 100 ? cut.slice(0, lastComma) : cut).trim();\n}\n// Also collapse any accidental duplicate comma-separated tags\nconst seen = new Set();\nprompt = prompt.split(',').map(t => t.trim()).filter(t => {\n  const key = t.toLowerCase();\n  if (!t || seen.has(key)) return false;\n  seen.add(key);\n  return true;\n}).join(', ');\nreturn [{ json: { image_prompt: prompt, topic: $('Code - Finalize Unique Topic').first().json.topic } }];"
      },
      "id": "parse-image-prompt",
      "name": "Code - Parse Image Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
